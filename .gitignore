# Dart / pub
.dart_tool/
.packages
build/
pubspec.lock
doc/api/

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store

# Agent worktrees created by the harness; never part of the package.
.claude/worktrees/

# NOTE: never add `guidelines` or `assets` (or any pattern matching them) to
# this file. `dart pub publish` honours .gitignore, and both trees are the
# package's payload -- excluding either produces a release that composes
# nothing or ships without the infer-conventions procedure.
# tool/verify_assets.dart guards both in CI.
