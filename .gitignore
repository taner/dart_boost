# Dart / pub
.dart_tool/
.packages
build/
pubspec.lock
doc/api/

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store

# Agent worktrees created by the harness; never part of the package.
.claude/worktrees/

# NOTE: publishing is governed by `.pubignore`, not this file. A `.pubignore`
# in a directory *replaces* the `.gitignore` there rather than merging with it,
# so the build-output entries above are repeated in `.pubignore` too -- change
# one, change the other.
#
# Never add `guidelines` or `assets` (or any pattern matching them) to either
# file. Both trees are the package's payload, and excluding either produces a
# release that composes nothing or ships without the infer-conventions
# procedure. tool/verify_assets.dart checks both against the real publish
# manifest and is what will catch you.
