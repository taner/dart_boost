# NOTE: never add `guidelines` (or any pattern matching it) to this file.
# `dart pub publish` honours .gitignore, and the guidelines/ tree is the
# package's payload -- excluding it produces a release that composes nothing.
# tool/verify_assets.dart guards this in CI.
